# Supabase staging
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# App
APP_ENV=staging
SECRET_KEY=generate-a-random-staging-secret-with-at-least-32-chars
ADMIN_API_KEY_ENABLED=false
ADMIN_API_KEY=disabled-in-staging
ALLOWED_ORIGINS=https://lugano-staging.vercel.app,https://lugano-staging.netlify.app
ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type,X-Admin-Key
LOG_LEVEL=INFO

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/health/ready
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Delivery
DELIVERY_BASE_FEE=500
DELIVERY_FREE_THRESHOLD=5000

# Pagamentos
PAYMENT_PROVIDER=manual
PIX_KEY=
PIX_MERCHANT_NAME=Lugano
PIX_MERCHANT_CITY=Gramado
PIX_TXID_PREFIX=LUG
PIX_EXPIRES_MINUTES=30
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TIMEOUT_SECONDS=10

# Fidelidade
POINTS_PER_REAL=10

# Notificacoes
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=false
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5

# Monitoramento
HEALTHCHECK_SUPABASE_ENABLED=true
MONITORING_ALERTS_ENABLED=true
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=
MONITORING_WEBHOOK_TIMEOUT_SECONDS=5
MONITORING_SERVICE_NAME=lugano-crm-staging
MONITORING_HEALTH_PATH=/health/ready
MONITORING_ENVIRONMENT=staging

# Pre-deploy checklist local
API_BASE_URL=https://lugano-crm-api-staging.onrender.com
PREDEPLOY_EXPECTED_ENV=staging
PREDEPLOY_ADMIN_EMAIL=owner-staging@lugano.test
PREDEPLOY_ADMIN_PASSWORD=change-this-password
PREDEPLOY_CUSTOMER_EMAIL=cliente-staging@lugano.test
PREDEPLOY_CUSTOMER_PASSWORD=change-this-password

# Final security review
FINAL_SECURITY_OWNER_EMAIL=owner-staging@lugano.test
FINAL_SECURITY_OWNER_PASSWORD=change-this-password
FINAL_SECURITY_REQUIRE_REMOTE=true

# Initial seed
SEED_OWNER_EMAIL=owner-staging@lugano.test
SEED_OWNER_PASSWORD=change-this-password
SEED_OWNER_FULL_NAME=Owner Staging Lugano
