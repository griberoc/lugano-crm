# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-use-in-frontend

# App
APP_ENV=development
SECRET_KEY=your-secret-key-min-32-chars
ADMIN_API_KEY=change-this-admin-key
ADMIN_API_KEY_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type,X-Admin-Key
LOG_LEVEL=INFO

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/health/ready,/docs,/redoc,/openapi.json
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Delivery
DELIVERY_BASE_FEE=500        # em centavos (R$ 5,00)
DELIVERY_FREE_THRESHOLD=5000 # pedido acima de R$ 50,00 tem frete grátis

# Pagamentos
PAYMENT_PROVIDER=manual
PIX_KEY=
PIX_MERCHANT_NAME=Lugano
PIX_MERCHANT_CITY=Gramado
PIX_TXID_PREFIX=LUG
PIX_EXPIRES_MINUTES=30
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TIMEOUT_SECONDS=10

# Fidelidade
POINTS_PER_REAL=10           # 10 pontos por R$ 1,00 gasto

# Notificacoes
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=true
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5

# Monitoramento
HEALTHCHECK_SUPABASE_ENABLED=true
MONITORING_ALERTS_ENABLED=true
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=
MONITORING_WEBHOOK_TIMEOUT_SECONDS=5
MONITORING_SERVICE_NAME=lugano-crm
